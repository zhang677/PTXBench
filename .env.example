PTXBENCH_ROOT=/home/ubuntu/PTXBench
PTXBENCH_HOST_ROOT=/home/ubuntu/PTXBench
PTXBENCH_DATA_ROOT=/home/ubuntu/PTXBench/data
PTXBENCH_TRACESET_ROOT=/home/ubuntu/accrl-training
PTXBENCH_HEAVY_TRACESET_ROOT=/home/ubuntu/accrl-training-heavy
MINI_PTX_AGENT_ROOT=/home/ubuntu/PTXBench/packages/mini-ptx-agent

FIBSERVE_PORT=10000
FIB_DEVICES=cuda:0,cuda:1
FIB_GPU_0=0
FIB_GPU_1=1
FIB_TIMEOUT=30
TVM_FFI_CUDA_ARCH_LIST=9.0a

# Exact model ID and a dedicated endpoint used only for PTXBench.
MODEL_NAME=Qwen3.6-27B
ACCRL_MODEL_HOST=localhost:30062
