# Copy to .env and source it, or export only the values used by your stage.
PTXBENCH_DATA_ROOT=/absolute/path/to/ptxbench-data
SERVICE_URL=http://localhost:10000
PTXBENCH_MODEL_HOST=localhost:30002
GEMINI_API_KEY=
OPENROUTER_API_KEY=
TINKER_API_KEY=
# Remote SGLang host and container for stages Fixit 08 / KernelGen 05.
REMOTE=
CONTAINER=
# Optional: Python with tinker-cookbook inside the serving container.
REMOTE_PYTHON=/data02/tinker-cookbook/.venv/bin/python
PTXBENCH_REMOTE_DATA_ROOT=/data02
