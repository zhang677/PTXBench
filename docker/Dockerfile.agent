FROM python:3.12-slim-bookworm

ARG DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_LINK_MODE=copy \
    UV_CACHE_DIR=/opt/uv-cache \
    UV_PROJECT_ENVIRONMENT=/opt/ptxbench-venv \
    PTXBENCH_ROOT=/workspace/PTXBench \
    MINI_PTX_AGENT_ROOT=/workspace/PTXBench/packages/mini-ptx-agent \
    PTXBENCH_DATA_ROOT=/workspace/PTXBench/data

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        docker.io \
        git \
        tmux \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.8.22 /uv /uvx /usr/local/bin/

WORKDIR /workspace/PTXBench
COPY pyproject.toml uv.lock README.md ./
COPY packages packages
COPY configs configs
COPY experiments experiments
COPY scripts scripts

RUN uv sync --frozen --package mini-ptx-agent --extra training --no-dev \
    && rm -rf "$UV_CACHE_DIR"

ENV PATH="/opt/ptxbench-venv/bin:${PATH}"
ENTRYPOINT ["ptxbench"]
CMD ["doctor"]
