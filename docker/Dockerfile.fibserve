FROM nvidia/cuda:13.0.2-devel-ubuntu22.04

ARG DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_LINK_MODE=copy \
    UV_CACHE_DIR=/opt/uv-cache

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        gpg-agent \
        ninja-build \
        procps \
        software-properties-common \
        tmux \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        python3.12 \
        python3.12-dev \
        python3.12-venv \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1

COPY --from=ghcr.io/astral-sh/uv:0.8.22 /uv /uvx /usr/local/bin/

WORKDIR /workspace/PTXBench
COPY pyproject.toml uv.lock README.md ./
COPY packages packages

RUN uv sync --frozen --package fibserve --extra serve --no-dev \
    && chmod +x \
        packages/fibserve/scripts/gpu_preflight.sh \
        packages/fibserve/scripts/launch_fib_serve_dispatcher.sh \
        packages/fibserve/scripts/restart_profiling.sh \
        packages/fibserve/scripts/run_verify.sh \
        packages/fibserve/scripts/run_fibserve_dispatcher_container.sh \
    && rm -rf "$UV_CACHE_DIR"

ENV PATH="/workspace/PTXBench/.venv/bin:${PATH}"
EXPOSE 10000

ENTRYPOINT ["/workspace/PTXBench/packages/fibserve/scripts/run_fibserve_dispatcher_container.sh"]
