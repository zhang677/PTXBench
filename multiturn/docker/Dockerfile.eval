FROM nvidia/cuda:13.2.0-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install Python 3.12 via deadsnakes PPA
RUN apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common gpg-agent && \
    add-apt-repository ppa:deadsnakes/ppa && \
    apt-get update && apt-get install -y --no-install-recommends \
        python3.12 python3.12-dev python3.12-venv \
        bash sed coreutils curl && \
    rm -rf /var/lib/apt/lists/*

# Make python3.12 the default python3/python
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 && \
    update-alternatives --install /usr/bin/python  python  /usr/bin/python3.12 1

# Bootstrap pip for 3.12
RUN curl -sS https://bootstrap.pypa.io/get-pip.py | python3.12

# Install PyTorch (CUDA 13.0) and apache-tvm-ffi
RUN pip install --no-cache-dir \
        torch==2.12.1+cu130 --index-url https://download.pytorch.org/whl/cu130 && \
    pip install --no-cache-dir triton==3.7.1 cupti-python==13.0.1 apache-tvm-ffi==0.1.9 requests==2.33.0
RUN python -c 'import torch, triton; assert torch.__version__ == "2.12.1+cu130"; assert triton.__version__ == "3.7.1"'

WORKDIR /workspace
